{
  "schema": 1,
  "version": "0.1.16",
  "title": "Jakość przypisana do konkretnej pozycji ZL",
  "description": "Sprawdź, że brak/poprawka/złom dotyczą konkretnego produktu w zleceniu, a nie całego ZL. Punkty zaliczają się automatycznie.",
  "checks": [
    {
      "id": "quality-open",
      "text": "1. Kliknij JAKOŚĆ na pasku kierownika.",
      "trigger": "quality:open"
    },
    {
      "id": "quality-dialog",
      "text": "2. Kliknij „Nowe zgłoszenie”.",
      "trigger": "quality:dialog_open"
    },
    {
      "id": "quality-order",
      "text": "3. Wybierz ZL-740.",
      "trigger": "quality:order_selected"
    },
    {
      "id": "quality-item",
      "text": "4. W polu „2. Pozycja / produkt” wybierz konkretną pozycję ZL-740.",
      "trigger": "quality:item_selected"
    },
    {
      "id": "quality-department",
      "text": "5. Wybierz dział Zgrzewarki.",
      "trigger": "quality:department_selected"
    },
    {
      "id": "quality-kind",
      "text": "6. Wybierz POPRAWKA.",
      "trigger": "quality:kind_rework"
    },
    {
      "id": "quality-target",
      "text": "7. Wybierz wcześniejszy etap Giętarki.",
      "trigger": "quality:target_selected"
    },
    {
      "id": "quality-save",
      "text": "8. Sprawdź, że „Zapisz zgłoszenie” jest aktywne.",
      "trigger": "quality:save_enabled"
    },
    {
      "id": "quality-reason",
      "text": "9. Wpisz przyczynę, np. „Test pozycji”, i kliknij poza pole.",
      "trigger": "quality:reason_entered"
    },
    {
      "id": "rework-create",
      "text": "10. Zapisz POPRAWKĘ. W tabeli jakości ma być widoczny konkretny symbol/nazwa produktu.",
      "trigger": "rework:create"
    },
    {
      "id": "rework-start",
      "text": "11. Zaznacz poprawkę i kliknij „Rozpocznij naprawę”.",
      "trigger": "rework:start"
    },
    {
      "id": "rework-repaired",
      "text": "12. Kliknij „Oznacz naprawione”.",
      "trigger": "rework:repaired"
    },
    {
      "id": "rework-accept",
      "text": "13. Kliknij „Zaakceptuj poprawkę”.",
      "trigger": "rework:accept"
    },
    {
      "id": "order-history",
      "text": "14. Otwórz ZL-740 i sprawdź Historię.",
      "trigger": "order:history"
    },
    {
      "id": "copy-report",
      "text": "15. Kliknij „Kopiuj raport”.",
      "trigger": "update_panel:copy_report"
    },
    {
      "id": "ready-next",
      "text": "16. Jeśli wszystko jest OK, kliknij „Gotowy na następne zmiany”.",
      "trigger": "update_panel:ready"
    }
  ]
}