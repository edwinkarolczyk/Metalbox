{
  "schema": 1,
  "version": "0.1.15.1",
  "title": "Naprawa zapisu POPRAWKI",
  "description": "Retest tylko miejsca, w którym 0.1.15 się zatrzymało, oraz dalszego obiegu poprawki.",
  "checks": [
    {
      "id": "quality-open",
      "text": "1. Kliknij JAKOŚĆ na pasku kierownika.",
      "trigger": "quality:open"
    },
    {
      "id": "quality-dialog",
      "text": "2. Kliknij „Nowe zgłoszenie”.",
      "trigger": "quality:dialog_open"
    },
    {
      "id": "quality-order",
      "text": "3. Wybierz ZL-740.",
      "trigger": "quality:order_selected"
    },
    {
      "id": "quality-department",
      "text": "4. Wybierz dział Zgrzewarki.",
      "trigger": "quality:department_selected"
    },
    {
      "id": "quality-kind",
      "text": "5. Wybierz typ POPRAWKA.",
      "trigger": "quality:kind_rework"
    },
    {
      "id": "quality-target",
      "text": "6. W polu „Cofnij do etapu” wybierz Giętarki.",
      "trigger": "quality:target_selected"
    },
    {
      "id": "quality-save-enabled",
      "text": "7. Sprawdź, że przycisk „Zapisz zgłoszenie” stał się aktywny.",
      "trigger": "quality:save_enabled"
    },
    {
      "id": "quality-reason",
      "text": "8. Wpisz przyczynę, np. „Test poprawki”, i kliknij poza pole.",
      "trigger": "quality:reason_entered"
    },
    {
      "id": "rework-create",
      "text": "9. Kliknij „Zapisz zgłoszenie”. Nowa poprawka ma pojawić się ze statusem DO_NAPRAWY.",
      "trigger": "rework:create"
    },
    {
      "id": "rework-start",
      "text": "10. Zaznacz poprawkę i kliknij „Rozpocznij naprawę”.",
      "trigger": "rework:start"
    },
    {
      "id": "rework-repaired",
      "text": "11. Kliknij „Oznacz naprawione”.",
      "trigger": "rework:repaired"
    },
    {
      "id": "rework-accept",
      "text": "12. Kliknij „Zaakceptuj poprawkę”. Status ma zmienić się na ZAMKNIĘTA.",
      "trigger": "rework:accept"
    },
    {
      "id": "order-history",
      "text": "13. Otwórz ZL-740 i kliknij Historia.",
      "trigger": "order:history"
    },
    {
      "id": "copy-report",
      "text": "14. Kliknij „Kopiuj raport”.",
      "trigger": "update_panel:copy_report"
    },
    {
      "id": "ready-next",
      "text": "15. Jeśli wszystko jest OK, kliknij „Gotowy na następne zmiany”.",
      "trigger": "update_panel:ready"
    }
  ]
}